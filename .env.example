# Ring Developer Playground token (https://developer.amazon.com/ring/console/playground)
# Short-lived (~30 min). Enough to run POST /api/live and scripts/ring-probe.ts.
RING_ACCESS_TOKEN=

# Long-lived deployments: OAuth account linking instead of a Playground token.
# RING_REFRESH_TOKEN=
# RING_CLIENT_ID=
# RING_CLIENT_SECRET=

# HMAC signing key issued with your partner credentials. Webhook signatures are verified
# whenever this is set, and REQUIRED when NODE_ENV=production.
RING_WEBHOOK_SECRET=

# Optional: let Bedrock rephrase the family message. Falls back to the rules version.
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
